#!/bin/bash
# Sunshine prep command of every app Albedo creates: switches the stream's monitor to the client's
# resolution/FPS before the stream and puts the saved layout back after it. The work happens in
# Albedo Companion (`albedo-companion display`, companion/src/stream_display_switcher.rs), which
# knows the route the Deck profile picked: virtual connector, dummy plug, main monitor or none.
#   sunshine-match-client                      (do: uses SUNSHINE_CLIENT_WIDTH/HEIGHT/FPS from Sunshine)
#   sunshine-match-client --restore            (undo: restores the saved layout)
#   sunshine-match-client --dry-run            (only prints the chosen mode and command)
#   sunshine-match-client --restore --dry-run  (only prints the restore command)
# The outputs come from ~/.config/sunshine-match-client.conf (VIRTUAL_OUTPUT=…, DUMMY_OUTPUT=…,
# optional MAIN_OUTPUT=…), written by pc-setup/install.sh. ALBEDO_COMPANION overrides the program.
companion="${ALBEDO_COMPANION:-$HOME/Applications/Albedo-Companion-x86_64.AppImage}"
if [ ! -x "$companion" ]
then
    mkdir -p "$HOME/.local/state"
    echo "$(date '+%F %T') $companion missing, run pc-setup/install.sh" | tee -a "$HOME/.local/state/sunshine-match-client.log"
    exit 1
fi
exec "$companion" display "$@"
