{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Albedo Companion",
  "version": "0.2.3",
  "identifier": "de.davidf.albedo.pc",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1440",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Albedo Companion",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZBMzM4REM1MzZGM0VCMEQKUldRTjYvTTJ4WTB6YWoxb1lVUnc3bXVLdE9uMFBXbWx0WGlMUWU0dmxydEVsNkg0MDNzcnFGeGUK",
      "endpoints": [
        "https://github.com/Dav1d-Fn/Albedo/releases/latest/download/latest-companion.json"
      ]
    }
  }
}
